                    document.getElementById('notificationCount').textContent = count;
                });
        }

        // Fetch count every 5 seconds
        setInterval(fetchNotificationCount, 5000);
        fetchNotificationCount(); // Initial call
    </script>

<script src="/js/security.js"></script>




    <!--end::Script-->
</body>
<!--end::Body-->

</html>"
